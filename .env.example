# Environment variables and paths
# Copy to .env and fill in values

# Ollama LLM endpoint
LLM_API_HOST=localhost
LLM_API_PORT=11434
LLM_API_PATH=/api/chat

# Whisper model
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda

# TTS
TTS_VOICE_DEFAULT=cochran
KOKORO_FALLBACK_VOICE=am_michael

# LLM
LLM_MODEL_DEFAULT=deepseek-v4-flash:cloud
LLM_MAX_TOKENS=60
LLM_TEMPERATURE=0.7
THINK_INTERVAL=4

# Audio capture (WSL paths — Windows version uses B:\ paths)
# AUDIO_FILE=/mnt/b/cochran_audio.raw
# AUDIO_FILE_CLIENT=/mnt/b/cochran_audio_client.raw
CHUNK_SECONDS=6
OVERLAP_SECONDS=2
SILENCE_THRESHOLD=3

# Echo suppression
ECHO_SUPPRESSION_COOLDOWN=45
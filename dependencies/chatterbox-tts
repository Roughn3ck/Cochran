"""Chatterbox TTS wrapper v3 - Natural pace, chunked for length

v3 changes:
- Splits text into chunks at sentence boundaries to avoid 40s max_new_tokens cutoff
- Concatenates chunks into single output
- Slower pacing: higher repetition_penalty, lower temperature
- Adds natural pauses between sentences via period-delimited chunks
"""
import sys
import os
import numpy as np
import torch
import soundfile as sf

def split_text_into_chunks(text, max_chars=200):
    """Split text into chunks at sentence boundaries, each under max_chars."""
    # Split on sentence endings
    sentences = []
    current = ""
    for char in text:
        current += char
        if char in '.!?' and len(current.strip()) > 0:
            sentences.append(current.strip())
            current = ""
    if current.strip():
        sentences.append(current.strip())
    
    # Group sentences into chunks under max_chars
    chunks = []
    current_chunk = ""
    for sentence in sentences:
        if len(current_chunk) + len(sentence) + 1 > max_chars and current_chunk:
            chunks.append(current_chunk.strip())
            current_chunk = sentence
        else:
            current_chunk = (current_chunk + " " + sentence).strip()
    if current_chunk.strip():
        chunks.append(current_chunk.strip())
    
    return chunks

def main():
    if len(sys.argv) < 2:
        print("Usage: chatterbox-tts <text> [output_path] [reference_audio]", file=sys.stderr)
        sys.exit(1)
    
    text = sys.argv[1]
    output_path = sys.argv[2] if len(sys.argv) > 2 else "/tmp/chatterbox-output.wav"
    reference_audio = sys.argv[3] if len(sys.argv) > 3 else "/home/krisr/.local/share/chatterbox/kris-reference-24k.wav"
    
    from chatterbox.tts import ChatterboxTTS
    
    model = ChatterboxTTS.from_pretrained(device="cuda")
    
    # Split text into chunks to avoid 40s cutoff
    chunks = split_text_into_chunks(text, max_chars=180)
    
    if len(chunks) > 1:
        print(f"Split into {len(chunks)} chunks for length", file=sys.stderr)
    
    wavs = []
    for i, chunk in enumerate(chunks):
        print(f"Generating chunk {i+1}/{len(chunks)}: {chunk[:60]}...", file=sys.stderr)
        wav = model.generate(
            chunk,
            audio_prompt_path=reference_audio,
            exaggeration=0.6,
            temperature=0.35,      # Lower = slower, more deliberate
            cfg_weight=0.7,
            repetition_penalty=1.6, # Higher = more pauses, slower pace
        )
        wavs.append(wav.squeeze().numpy())
        
        # Add 0.5s silence between chunks for natural pause
        if i < len(chunks) - 1:
            silence = np.zeros(int(model.sr * 0.5))
            wavs.append(silence)
    
    # Concatenate all chunks
    full_wav = np.concatenate(wavs)
    sf.write(output_path, full_wav, model.sr)
    print(f"Output: {len(full_wav)/model.sr:.1f}s saved to {output_path}", file=sys.stderr)

if __name__ == "__main__":
    main()